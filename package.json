{
  "name": "minibucket",
  "version": "1.0.0",
  "description": "Self-hosted S3-style asset storage, CDN origin and object server with JSON metadata indexing",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed": "node scripts/seed-test.mjs",
    "rebuild-index": "tsx src/cli/rebuild.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "optionalDependencies": {
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
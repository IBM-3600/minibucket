# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Logging
LOG_LEVEL=info
LOG_FILE=./data/logs/minibucket.log


# ── Storage ───────────────────────────────────────────────────────────────
# Root directory for all persisted data (assets, metadata, thumbnails, tmp)
STORAGE_DIR=./data
# Custom category/extension mapping file (JSON). Defaults to ./config/categories.json
CATEGORIES_FILE=./config/categories.json
# Naming strategy for stored files: hash | timestamp | uuid
NAMING_STRATEGY=hash
# Deduplicate uploads by SHA-256 (returns existing record instead of storing twice)
DEDUPE=true
MAX_FILE_SIZE=5368709120        # 5 GiB per object
MAX_CHUNK_SIZE=16777216         # 16 MiB per resumable chunk
WORKER_CONCURRENCY=2

# ── CDN ───────────────────────────────────────────────────────────────────
CDN_MAX_AGE=31536000            # 1 year, served with `immutable`
ALLOWED_ORIGINS=*               # comma separated list, or *

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# Bootstrap admin password (used to create the initial `admin` user)
ADMIN_PASSWORD=admin
# UI_PASSWORD is accepted as an alias of ADMIN_PASSWORD
RATE_LIMIT_RPM=600              # default requests/minute per credential

# ── Features ──────────────────────────────────────────────────────────────
THUMBNAIL_ENABLED=true          # requires `sharp` (optional dep) for images
ENABLE_WEBSOCKETS=false         # reserved; live updates currently use SSE
S3_COMPAT_ENABLED=false         # mount /s3 endpoint with AWS SigV4 auth
S3_BUCKET=assets
S3_REGION=us-east-1